# Local dev secrets — gitignored, never committed. Generated for the local stack.
POSTGRES_PASSWORD=devpass
REDIS_PASSWORD=devpass
AUTH_SIGNING_KEY_SEED=+oqI3vFMoHSn+smoR6gXin7bzjEpwnlROOqG5nBVyr0=

# Social login (Sign in with Google). Only client ids — no secrets.
# Web client id is also passed to the app as serverClientId, so mobile tokens
# carry it as `aud` too; it covers web + mobile.
AUTH_OIDC_GOOGLE_CLIENT_ID_WEB=509452346817-13k4thi73iu7dhu59ts861abseldfvkc.apps.googleusercontent.com
AUTH_OIDC_GOOGLE_CLIENT_ID_ANDROID=509452346817-hoa8ou0qp2titamopnupp88m15j7kmk0.apps.googleusercontent.com
AUTH_OIDC_GOOGLE_CLIENT_ID_IOS=509452346817-naoojh6bu7khg8rui1epjchjp067ktk7.apps.googleusercontent.com
#AUTH_OIDC_APPLE_CLIENT_ID_IOS=
#AUTH_OIDC_APPLE_CLIENT_ID_WEB=

# Host ports.
GATEWAY_PORT=8088
AUTH_POSTGRES_PORT=5432
AUTH_REDIS_PORT=6379
USER_POSTGRES_PORT=5433
TRAVEL_POSTGRES_PORT=5434
POST_POSTGRES_PORT=5435
STORE_POSTGRES_PORT=5436
MESSAGE_POSTGRES_PORT=5437
MEDIA_POSTGRES_PORT=5438

# Local mail catcher (Mailpit): http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local MinIO object storage.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AUTH_DATABASE_URL=postgres://auth:devpass@auth-postgres:5432/auth?sslmode=disable
USER_DATABASE_URL=postgres://user:devpass@user-postgres:5432/user?sslmode=disable
TRAVEL_DATABASE_URL=postgres://travel:devpass@travel-postgres:5432/travel?sslmode=disable
POST_DATABASE_URL=postgres://post:devpass@post-postgres:5432/post?sslmode=disable
STORE_DATABASE_URL=postgres://store:devpass@store-postgres:5432/store?sslmode=disable
STAY_DATABASE_URL=postgres://stay:devpass@stay-postgres:5432/stay?sslmode=disable
MESSAGE_DATABASE_URL=postgres://message:devpass@message-postgres:5432/message?sslmode=disable
MEDIA_DATABASE_URL=postgres://media:devpass@media-postgres:5432/media?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://unused:unused@localhost:5432/unused
