# Copy to .env (a ready dev .env is already committed).  docker compose reads this.
#
# Shared dev secrets for the local stack. Generate real values for anything real:
#   AUTH_SIGNING_KEY_SEED — openssl rand -base64 32   (32-byte base64 seed)
POSTGRES_PASSWORD=devpass
REDIS_PASSWORD=devpass
AUTH_SIGNING_KEY_SEED=replace-with-base64-32-byte-seed

# Social login (Sign in with Google/Apple). Auth only needs each platform's
# OAuth *client id* (no secrets/key files — it fetches provider public keys
# itself). Fill the slot per platform you run; leave all empty to disable social
# login. (Combined AUTH_OIDC_GOOGLE_CLIENT_IDS / _APPLE_CLIENT_IDS still work —
# everything is merged & de-duplicated.)
#AUTH_OIDC_GOOGLE_CLIENT_ID_WEB=1234-web.apps.googleusercontent.com
#AUTH_OIDC_GOOGLE_CLIENT_ID_ANDROID=1234-android.apps.googleusercontent.com
#AUTH_OIDC_GOOGLE_CLIENT_ID_IOS=1234-ios.apps.googleusercontent.com
#AUTH_OIDC_APPLE_CLIENT_ID_IOS=app.pmapa.ios
#AUTH_OIDC_APPLE_CLIENT_ID_WEB=app.pmapa.web

# Host ports (override to avoid clashes with anything already running locally).
GATEWAY_PORT=8088
AUTH_POSTGRES_PORT=5432
AUTH_REDIS_PORT=6379
USER_POSTGRES_PORT=5433
TRAVEL_POSTGRES_PORT=5434
POST_POSTGRES_PORT=5435
STORE_POSTGRES_PORT=5436
MESSAGE_POSTGRES_PORT=5437
MEDIA_POSTGRES_PORT=5438

# Email delivery lives in the NOTIFICATION service (templates + SMTP); auth
# just calls it. By default compose routes mail into the local Mailpit
# catcher — open http://localhost:8025 to read it. For a real relay
# (Postmark/SES/Mailgun/Gmail): host + 587 (STARTTLS) or 465 (implicit TLS)
# + username/password. Set NOTIFICATION_SMTP_HOST= (empty) to log emails
# instead of sending; set AUTH_NOTIFICATION_URL= (empty) to make auth log
# reset tokens without calling notification at all.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
#NOTIFICATION_SMTP_HOST=smtp.example.com
#NOTIFICATION_SMTP_PORT=587
#NOTIFICATION_SMTP_USERNAME=...
#NOTIFICATION_SMTP_PASSWORD=...
#NOTIFICATION_SMTP_FROM=PMapa <no-reply@pmapa.app>
#NOTIFICATION_RESET_URL_BASE=https://pmapa.app/reset?token=

# Local MinIO (S3-compatible object storage for the media service).
# The compose file starts a `minio` container and creates the bucket; the media
# service points at it by default, so photo upload works with no config at all.
# Console: http://localhost:9001 (minioadmin / minioadmin).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Override to point the media service at a real S3 provider instead of the
# local MinIO. Set MEDIA_S3_ENDPOINT= (empty) to fall back to Postgres blobs.
# PATH_STYLE=true for MinIO and most non-AWS providers; false for AWS
# virtual-hosted buckets.
#MEDIA_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#MEDIA_S3_REGION=eu-central-1
#MEDIA_S3_BUCKET=my-bucket
#MEDIA_S3_ACCESS_KEY=...
#MEDIA_S3_SECRET_KEY=...
#MEDIA_S3_PREFIX=media/
#MEDIA_S3_PATH_STYLE=false

# ── telegrambot (ops alerts, off by default) ──────────────────────────
# Enable with: docker compose --profile ops up  (after setting token + chat).
# Polls every service's /readyz, /internal/logz, /internal/stats; alerts to
# Telegram on a down service or new WARN+ logs; posts a status report on a timer.
#TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
#TELEGRAM_CHAT_ID=-1001234567890
#TELEGRAM_POLL_INTERVAL=30s
#TELEGRAM_REPORT_INTERVAL=24h
#TELEGRAM_ALERT_COOLDOWN=5m   # min gap between error alerts per service (coalesced)
