# Copy to .env (a ready dev .env is already committed).  docker compose reads this.
#
# Shared dev secrets for the local stack. Generate real values for anything real:
#   AUTH_SIGNING_KEY_SEED — openssl rand -base64 32   (32-byte base64 seed)
AUTH_SIGNING_KEY_SEED=replace-with-base64-32-byte-seed

# ── External Redis (managed) ────────────────────────────────────────────────
# No Redis container any more — anywhere in this repo. auth and stats
# share ONE instance, db 0 — safe because the key spaces do not overlap:
# auth writes deny:*, dpop:*, fail:*, stats writes metric:*, and neither ever
# runs FLUSHDB. The password is passed OUT-OF-BAND (REDIS_PASSWORD), never
# inside the URL, so any characters are fine — no URL-encoding.
#
# Check it:  redis-cli -u redis://default:$REDIS_PASSWORD@generative-thorough-birthday-92146.db.redis.io:18624 ping
REDIS_PASSWORD=change-me
# Override only to point dev at a different instance (e.g. db 1, or a local one):
#REDIS_URL=redis://default@generative-thorough-birthday-92146.db.redis.io:18624/0

# ── External Postgres at 80.66.64.227 ───────────────────────────────────────
# No Postgres container any more — anywhere in this repo. Each service
# gets its OWN database AND login role, both named pmapa_<svc> — e.g. the travel
# service connects as user pmapa_travel to database pmapa_travel. Create them
# once (idempotent):
#
#   PGPASSWORD=<admin-password> ./env/db/external/provision.sh --with-test
#
# The script does NOT set or change passwords — you do:
#   psql -h 80.66.64.227 -U postgres -c "ALTER ROLE pmapa_travel PASSWORD 'your-password'"
# then paste the same password into the URL below. It prints ready-made
# <SVC>_DATABASE_URL lines for exactly this block.
#
# ADMIN_DATABASE_URL is used ONLY by provision.sh and `./build.sh test-db`
# (which creates the pmapa_<svc>_test databases). Services never see it.
#ADMIN_DATABASE_URL=postgres://postgres:PW@80.66.64.227:5432/postgres?sslmode=require
#AUTH_DATABASE_URL=postgres://pmapa_auth:PW@80.66.64.227:5432/pmapa_auth?sslmode=require
#USER_DATABASE_URL=postgres://pmapa_user:PW@80.66.64.227:5432/pmapa_user?sslmode=require
#TRAVEL_DATABASE_URL=postgres://pmapa_travel:PW@80.66.64.227:5432/pmapa_travel?sslmode=require
#POST_DATABASE_URL=postgres://pmapa_post:PW@80.66.64.227:5432/pmapa_post?sslmode=require
#STORE_DATABASE_URL=postgres://pmapa_store:PW@80.66.64.227:5432/pmapa_store?sslmode=require
#STAY_DATABASE_URL=postgres://pmapa_stay:PW@80.66.64.227:5432/pmapa_stay?sslmode=require
#MESSAGE_DATABASE_URL=postgres://pmapa_message:PW@80.66.64.227:5432/pmapa_message?sslmode=require
#MEDIA_DATABASE_URL=postgres://pmapa_media:PW@80.66.64.227:5432/pmapa_media?sslmode=require
#NOTIFICATION_DATABASE_URL=postgres://pmapa_notification:PW@80.66.64.227:5432/pmapa_notification?sslmode=require

# Social login (Sign in with Google/Apple). Auth only needs each platform's
# OAuth *client id* (no secrets/key files — it fetches provider public keys
# itself). Fill the slot per platform you run; leave all empty to disable social
# login. (Combined AUTH_OIDC_GOOGLE_CLIENT_IDS / _APPLE_CLIENT_IDS still work —
# everything is merged & de-duplicated.)
#AUTH_OIDC_GOOGLE_CLIENT_ID_WEB=1234-web.apps.googleusercontent.com
#AUTH_OIDC_GOOGLE_CLIENT_ID_ANDROID=1234-android.apps.googleusercontent.com
#AUTH_OIDC_GOOGLE_CLIENT_ID_IOS=1234-ios.apps.googleusercontent.com
#AUTH_OIDC_APPLE_CLIENT_ID_IOS=app.pmapa.ios
#AUTH_OIDC_APPLE_CLIENT_ID_WEB=app.pmapa.web

# Host ports (override to avoid clashes with anything already running locally).
# No *_POSTGRES_PORT any more — the database is external, reach it with psql
# directly using the URLs above.
GATEWAY_PORT=8088

# Email delivery lives in the NOTIFICATION service (templates + SMTP); auth
# just calls it. By default compose routes mail into the local Mailpit
# catcher — open http://localhost:8025 to read it. For a real relay
# (Postmark/SES/Mailgun/Gmail): host + 587 (STARTTLS) or 465 (implicit TLS)
# + username/password. Set NOTIFICATION_SMTP_HOST= (empty) to log emails
# instead of sending; set AUTH_NOTIFICATION_URL= (empty) to make auth log
# reset tokens without calling notification at all.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
#NOTIFICATION_SMTP_HOST=smtp.example.com
#NOTIFICATION_SMTP_PORT=587
#NOTIFICATION_SMTP_USERNAME=...
#NOTIFICATION_SMTP_PASSWORD=...
#NOTIFICATION_SMTP_FROM=PMapa <no-reply@pmapa.app>
#NOTIFICATION_RESET_URL_BASE=https://pmapa.app/reset?token=

# Local MinIO (S3-compatible object storage for the media service).
# The compose file starts a `minio` container and creates the bucket; the media
# service points at it by default, so photo upload works with no config at all.
# Console: http://localhost:9001 (minioadmin / minioadmin).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Override to point the media service at a real S3 provider instead of the
# local MinIO. Set MEDIA_S3_ENDPOINT= (empty) to fall back to Postgres blobs.
# PATH_STYLE=true for MinIO and most non-AWS providers; false for AWS
# virtual-hosted buckets.
#MEDIA_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#MEDIA_S3_REGION=eu-central-1
#MEDIA_S3_BUCKET=my-bucket
#MEDIA_S3_ACCESS_KEY=...
#MEDIA_S3_SECRET_KEY=...
#MEDIA_S3_PREFIX=media/
#MEDIA_S3_PATH_STYLE=false

# ── Cloudflare R2 + CDN (what prod uses; see env/prod/media) ──────────
# R2 is S3-compatible, so the same MEDIA_S3_* vars drive it:
#   * ENDPOINT is account-scoped, NOT bucket-scoped;
#   * REGION must be the literal "auto" (single region, used in the SigV4 scope);
#   * PATH_STYLE must stay true on the r2.cloudflarestorage.com endpoint;
#   * keys come from R2 → Manage API Tokens, scoped to the bucket with
#     "Object Read & Write" (an account-wide key also works but is broader).
#MEDIA_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
#MEDIA_S3_REGION=auto
#MEDIA_S3_BUCKET=pmapa-media
#MEDIA_S3_ACCESS_KEY=<r2-access-key-id>
#MEDIA_S3_SECRET_KEY=<r2-secret-access-key>
#MEDIA_S3_PREFIX=media/
#MEDIA_S3_PATH_STYLE=true
#
# CDN in front of the bucket for READS. Bind a custom domain to the bucket
# (R2 → bucket → Settings → Public access → Custom domain) — that puts the
# Cloudflare cache in front of R2 and gives it a public hostname. With this set,
# UploadImage returns the CDN URL and GET /media/{id} 302s to the edge, so image
# bytes never pass through the VPS. The edge maps the URL path onto the object
# key, so MEDIA_S3_PREFIX must match the path: <base>/media/<id>.
# Leave empty (or unset) to keep proxying reads through the media service.
#MEDIA_S3_PUBLIC_BASE_URL=https://cdn.pmapa.app

# ── telegrambot (ops alerts, off by default) ──────────────────────────
# Enable with: docker compose --profile ops up  (after setting token + chat).
# Polls every service's /readyz, /internal/logz, /internal/stats; alerts to
# Telegram on a down service or new WARN+ logs; posts a status report on a timer.
#TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
#TELEGRAM_CHAT_ID=-1001234567890
#TELEGRAM_POLL_INTERVAL=30s
#TELEGRAM_REPORT_INTERVAL=24h
#TELEGRAM_ALERT_COOLDOWN=5m   # min gap between error alerts per service (coalesced)
