# Fill these by hand — everything else (image, TTLs, in-cluster URLs) is baked
# into docker-compose.yml.

# On-box data tier (env/prod/infra). Keep the passwords in sync with infra/.env.
# When you extract a DB: swap the host + set sslmode=require here.
DATABASE_URL=postgres://auth:change-me@auth-postgres:5432/auth?sslmode=disable
REDIS_URL=redis://:change-me@auth-redis:6379/0

# Signing seed — openssl rand -base64 32
AUTH_SIGNING_KEY_SEED=replace-with-base64-32-byte-seed

# Optional — social login accepted OIDC client ids (comma-separated). Leave
# unset to keep social login disabled.
#AUTH_OIDC_GOOGLE_CLIENT_IDS=1234-abc.apps.googleusercontent.com
#AUTH_OIDC_APPLE_CLIENT_IDS=app.pmapa.ios
