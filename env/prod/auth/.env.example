# Fill these by hand — everything else (image, TTLs, in-cluster URLs, and the
# host/db parts of the connection strings) is baked into docker-compose.yml.

# Data-tier passwords — must EQUAL the same-named vars in env/prod/infra/.env.
# Delivered out-of-band (PGPASSWORD/REDIS_PASSWORD) — any characters are fine. openssl rand -base64 30
AUTH_POSTGRES_PASSWORD=change-me
AUTH_REDIS_PASSWORD=change-me

# Signing seed — openssl rand -base64 32
AUTH_SIGNING_KEY_SEED=replace-with-base64-32-byte-seed

# Social login (Sign in with Google/Apple). The service only needs each
# platform's OAuth *client id* — no secrets, no key files (it fetches the
# provider's public keys itself). A login token's `aud` must match one of the
# ids below. Fill the slot for each platform you ship; leave all unset to keep
# social login disabled. (You can also use the combined comma-separated
# AUTH_OIDC_GOOGLE_CLIENT_IDS / _APPLE_CLIENT_IDS forms — all are merged.)
#
# Google — create one OAuth client id per platform in Google Cloud Console.
# NOTE: on mobile the app passes the WEB id as serverClientId, so mobile tokens
# also carry the web id as `aud`; the web id alone is enough for mobile+web, but
# listing all is harmless.
#AUTH_OIDC_GOOGLE_CLIENT_ID_WEB=1234-web.apps.googleusercontent.com
#AUTH_OIDC_GOOGLE_CLIENT_ID_ANDROID=1234-android.apps.googleusercontent.com
#AUTH_OIDC_GOOGLE_CLIENT_ID_IOS=1234-ios.apps.googleusercontent.com
#
# Apple — the iOS id is the app's bundle id; the web id is your Services ID.
#AUTH_OIDC_APPLE_CLIENT_ID_IOS=app.pmapa.ios
#AUTH_OIDC_APPLE_CLIENT_ID_WEB=app.pmapa.web
