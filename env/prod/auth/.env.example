# Registry image to deploy (build + push from repo root).
IMAGE=ghcr.io/pmapa/auth:latest

# Managed data tier — use sslmode=require in the cloud.
DATABASE_URL=postgres://auth:CHANGE-ME@auth-db.internal:5432/auth?sslmode=require
REDIS_URL=redis://:CHANGE-ME@auth-redis.internal:6379/0

# Secrets — inject from your secret manager. Seed: openssl rand -base64 32
AUTH_SIGNING_KEY_SEED=replace-with-base64-32-byte-seed
AUTH_ACCESS_TTL=10m

# Social login (accepted OIDC client ids, comma-separated). Empty = disabled.
#AUTH_OIDC_GOOGLE_CLIENT_IDS=1234-abc.apps.googleusercontent.com
#AUTH_OIDC_APPLE_CLIENT_IDS=app.pmapa.ios

# Override in-cluster service URLs only if names differ from the defaults.
#AUTH_NOTIFICATION_URL=http://notification:8080
#AUTH_USER_URL=http://user:8080
#AUTH_POST_URL=http://post:8080
#AUTH_TRAVEL_URL=http://travel:8080
#AUTH_MESSAGE_URL=http://message:8080
#AUTH_MEDIA_URL=http://media:8080
