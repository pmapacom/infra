# env/prod/infra — passwords for the on-box data tier.
#
# Change every PASSWORD. Two values here are NOT passwords — the MinIO access
# key and the bucket name — and generating secrets into them breaks the media
# service in a way that only shows up when someone uploads a photo. They are
# marked below. Each password must MATCH the one you put in the matching
# service's connection string (env/prod/<svc>/.env) — the ready-made strings at
# the bottom already use these names, just keep the passwords in sync.
#
# All passwords are delivered to the services OUT-OF-BAND (PGPASSWORD /
# REDIS_PASSWORD / MinIO env), never embedded in a connection URL — so they may
# contain ANY characters. Generate however you like, e.g. openssl rand -base64 30.

# ── Postgres (one per service) ──
AUTH_POSTGRES_PASSWORD=change-me
USER_POSTGRES_PASSWORD=change-me
TRAVEL_POSTGRES_PASSWORD=change-me
POST_POSTGRES_PASSWORD=change-me
STORE_POSTGRES_PASSWORD=change-me
STAY_POSTGRES_PASSWORD=change-me
MESSAGE_POSTGRES_PASSWORD=change-me
MEDIA_POSTGRES_PASSWORD=change-me
NOTIFICATION_POSTGRES_PASSWORD=change-me

# ── Redis ──
AUTH_REDIS_PASSWORD=change-me
STATS_REDIS_PASSWORD=change-me

# ── MinIO (S3 for media) ──
# NOT a password: this is the S3 access key. Keep it short and plain ASCII
# (letters and digits) — `mc` refuses to build an alias from an arbitrary
# secret, and the bucket then never gets created.
MINIO_ROOT_USER=pmapa
# A password — but plain ASCII only, since it signs every S3 request.
MINIO_ROOT_PASSWORD=change-me
# NOT a password: this is the bucket NAME. Lowercase letters, digits and
# hyphens, 3-63 characters. The media service refuses to start otherwise.
MEDIA_S3_BUCKET=pmapa-media

# ─────────────────────────────────────────────────────────────────────────────
# Each service assembles its own connection URL from baked host/db + the password
# you give it — and it reads the SAME variable name as above. So "keep in sync"
# just means: put the same value under the same name in the service's .env, e.g.
#
#   env/prod/auth/.env    → AUTH_POSTGRES_PASSWORD=<same as here>, AUTH_REDIS_PASSWORD=<same>
#   env/prod/media/.env   → MEDIA_POSTGRES_PASSWORD=<same>, MINIO_ROOT_USER/PASSWORD=<same>
#   env/prod/stats/.env   → STATS_REDIS_PASSWORD=<same>
#   … one line per service (see each env/prod/<svc>/.env.example).
#
# The container names + sslmode=disable are baked in the service composes; when
# you extract a DB, edit the host + sslmode on that one compose's URL line.
# ─────────────────────────────────────────────────────────────────────────────
