# env/prod/infra — passwords for the on-box data tier.
#
# Change every value. Each password must MATCH the one you put in the matching
# service's connection string (env/prod/<svc>/.env) — the ready-made strings at
# the bottom already use these names, just keep the passwords in sync.

# ── Postgres (one per service) ──
AUTH_POSTGRES_PASSWORD=change-me
USER_POSTGRES_PASSWORD=change-me
TRAVEL_POSTGRES_PASSWORD=change-me
POST_POSTGRES_PASSWORD=change-me
STORE_POSTGRES_PASSWORD=change-me
MESSAGE_POSTGRES_PASSWORD=change-me
MEDIA_POSTGRES_PASSWORD=change-me
NOTIFICATION_POSTGRES_PASSWORD=change-me

# ── Redis ──
AUTH_REDIS_PASSWORD=change-me
STATS_REDIS_PASSWORD=change-me

# ── MinIO (S3 for media) ──
MINIO_ROOT_USER=pmapa
MINIO_ROOT_PASSWORD=change-me
MEDIA_S3_BUCKET=pmapa-media

# ─────────────────────────────────────────────────────────────────────────────
# Default connection strings — paste into each service's env/prod/<svc>/.env.
# Hosts are the in-network container names; sslmode=disable is fine on one box
# (traffic never leaves the host). When you extract a DB, swap the host + set
# sslmode=require in that one service's .env — nothing else changes.
#
#   auth   DATABASE_URL=postgres://auth:change-me@auth-postgres:5432/auth?sslmode=disable
#          REDIS_URL=redis://:change-me@auth-redis:6379/0
#   user   DATABASE_URL=postgres://user:change-me@user-postgres:5432/user?sslmode=disable
#   travel DATABASE_URL=postgres://travel:change-me@travel-postgres:5432/travel?sslmode=disable
#   post   DATABASE_URL=postgres://post:change-me@post-postgres:5432/post?sslmode=disable
#   store  DATABASE_URL=postgres://store:change-me@store-postgres:5432/store?sslmode=disable
#   message DATABASE_URL=postgres://message:change-me@message-postgres:5432/message?sslmode=disable
#   media  DATABASE_URL=postgres://media:change-me@media-postgres:5432/media?sslmode=disable
#          MEDIA_S3_ENDPOINT=http://minio:9000  (access=MINIO_ROOT_USER, secret=MINIO_ROOT_PASSWORD)
#   notification NOTIFICATION_DATABASE_URL=postgres://notification:change-me@notification-postgres:5432/notification?sslmode=disable
#   stats  REDIS_URL=redis://:change-me@stats-redis:6379/0
# ─────────────────────────────────────────────────────────────────────────────
