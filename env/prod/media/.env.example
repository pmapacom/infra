# Data-tier secrets — must EQUAL the same-named vars in env/prod/infra/.env.
# The endpoint/bucket/region/prefix/path-style are baked into docker-compose.yml.

# MEDIA_POSTGRES_PASSWORD is delivered out-of-band (PGPASSWORD) — any characters are fine
MEDIA_POSTGRES_PASSWORD=change-me

# On-box MinIO (S3) credentials — the SAME values as in env/prod/infra/.env.
# MINIO_ROOT_USER is the access key, not a password: short, plain ASCII.
MINIO_ROOT_USER=pmapa
# Plain ASCII: it signs every S3 request.
MINIO_ROOT_PASSWORD=change-me
# Override the bucket only if you changed it in infra (default pmapa-media).
# It is a NAME — lowercase letters, digits and hyphens — never a secret.
#MEDIA_S3_BUCKET=pmapa-media
