# Fill by hand — MEDIA_S3_PREFIX / PATH_STYLE / listen addr are baked into
# docker-compose.yml.
DATABASE_URL=postgres://media:CHANGE-ME@media-db.internal:5432/media?sslmode=require

# S3-compatible object storage for photo bytes.
# Leave MEDIA_S3_ENDPOINT empty to fall back to storing bytes in Postgres.
MEDIA_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_BUCKET=pmapa-media
MEDIA_S3_ACCESS_KEY=CHANGE-ME
MEDIA_S3_SECRET_KEY=CHANGE-ME
