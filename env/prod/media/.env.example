# Deploy-time secrets for the media service — the ONLY things not hardcoded in
# docker-compose.yml. Everything else about the R2 bucket s3-1 (account
# endpoint, bucket name, region, key prefix, path-style addressing and the
# public CDN host https://cdn1.pmapa.com) is a literal in the compose file.
#
# Copy to .env, or export these in whatever your deploy uses. All three are
# ${VAR:?} in the compose, so `docker compose up` fails fast if one is missing.
# Keep the filled-in .env out of git (see env/prod/.gitignore).

# -- secret -- shared Postgres password (role pmapa_user) on the external server
# Delivered out-of-band (PGPASSWORD), so any characters are fine.
MEDIA_POSTGRES_PASSWORD=change-me

# -- secret -- Cloudflare R2 Account API token for bucket s3-1
# R2 -> Manage API Tokens -> Create Account API token -> permission
# "Object Read & Write", applied to s3-1 only, no expiry. The secret key is
# shown ONCE on creation. Signs every upload; an Admin or account-wide token
# could also delete buckets, so do not reuse one.
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
