# On-box data tier (env/prod/infra). MEDIA_S3_PREFIX / PATH_STYLE / listen addr
# are baked into docker-compose.yml. Keep values in sync with infra/.env.
DATABASE_URL=postgres://media:change-me@media-postgres:5432/media?sslmode=disable

# S3 = the on-box MinIO. access/secret = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD,
# bucket = MEDIA_S3_BUCKET (all from infra/.env). Leave MEDIA_S3_ENDPOINT empty
# to fall back to storing bytes in Postgres instead.
MEDIA_S3_ENDPOINT=http://minio:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=pmapa-media
MEDIA_S3_ACCESS_KEY=pmapa
MEDIA_S3_SECRET_KEY=change-me
