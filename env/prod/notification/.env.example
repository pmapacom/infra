# Fill by hand — SMTP port / From header / listen addr are baked into
# docker-compose.yml.
NOTIFICATION_DATABASE_URL=postgres://notification:CHANGE-ME@notification-db.internal:5432/notification?sslmode=require

# SMTP relay. Leave NOTIFICATION_SMTP_HOST empty to log emails instead of sending.
NOTIFICATION_SMTP_HOST=smtp.example.com
NOTIFICATION_SMTP_USERNAME=CHANGE-ME
NOTIFICATION_SMTP_PASSWORD=CHANGE-ME

# Password-reset link base the emailed token is appended to.
NOTIFICATION_RESET_URL_BASE=https://pmapa.app/reset?token=
