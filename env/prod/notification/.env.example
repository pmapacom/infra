# Shared Postgres password (role pmapa_user) on the external server
# (80.66.64.227:5432) — the same value every service sets (under its own name).
# Delivered out-of-band (PGPASSWORD) — any characters are fine. openssl rand -base64 30.
# SMTP port / From header / listen addr are baked into docker-compose.yml.
NOTIFICATION_POSTGRES_PASSWORD=change-me

# SMTP relay. Leave NOTIFICATION_SMTP_HOST empty to log emails instead of sending.
NOTIFICATION_SMTP_HOST=smtp.example.com
NOTIFICATION_SMTP_USERNAME=CHANGE-ME
NOTIFICATION_SMTP_PASSWORD=CHANGE-ME

# Password-reset link base the emailed token is appended to.
NOTIFICATION_RESET_URL_BASE=https://pmapa.app/reset?token=
