# Redis password — the ONLY value to fill. Redis is EXTERNAL (managed):
# generative-thorough-birthday-92146.db.redis.io:18624, user `default`, db 0 —
# host/user/db are baked into docker-compose.yml.
#
# Delivered out-of-band (REDIS_PASSWORD), never inside the URL — any characters
# are fine, no URL-encoding needed. Same value as AUTH_REDIS_PASSWORD while a
# single instance is shared by both services.
#
# Check it before deploying:
#   redis-cli -u redis://default:PASSWORD@generative-thorough-birthday-92146.db.redis.io:18624 ping
STATS_REDIS_PASSWORD=change-me
