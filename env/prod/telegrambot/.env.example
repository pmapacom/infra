# Fill by hand — intervals + the monitored-service list are baked into
# docker-compose.yml.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# Fallback Bot API base — used only if api.telegram.org is unreachable (the bot
# tries direct first). Point it at a Cloudflare Worker reverse proxy when your
# host blocks Telegram (see cloudflare-worker.js + README here).
#TELEGRAM_API_BASE=https://pmapa-tg.<your-subdomain>.workers.dev
