# Data-tier password — must EQUAL USER_POSTGRES_PASSWORD in env/prod/infra/.env.
# Delivered out-of-band (PGPASSWORD/REDIS_PASSWORD) — any characters are fine. openssl rand -base64 30
USER_POSTGRES_PASSWORD=change-me

# Optional — comma-separated moderator user ids (unlocks the Moderation queue).
#USER_ADMIN_IDS=
